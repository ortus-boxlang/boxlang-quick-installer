# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
.tmp/
build/
bin/
runtime/build/
runtime/bin/
modules/test/

# Dynamically Generated docs
docs/

# IDEA files
.idea

# Mac Files
.DS_Store

# Generated sources
src/main/gen
*.tokens

# Temporary test files
src/test/resources/tmp/*
workbench/www/*

# CFML Parser test packages coming from CommandBox
cfml-parser-tests/**
/src/main/antlr/.antlr/*

# Core Module Class Files
src/main/java/ortus/boxlang/web/www/testbox/
/src/main/java/ortus/boxlang/web/www/coldbox

# JDBC artifacts
derby.log

# PowerShell module analysis cache. It is normally written under %LOCALAPPDATA%, but a
# process started without that variable (or with a relative one) writes it relative to
# the working directory instead, which puts it inside a checkout.
Microsoft/Windows/PowerShell/ModuleAnalysisCache
